{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Context Bundle SHA-256 Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "created_at",
    "algorithm",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "algorithm": {
      "const": "SHA-256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}