{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable AI Context Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "content",
    "status",
    "confidence",
    "sensitivity",
    "created_at",
    "updated_at",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "fact",
        "preference",
        "decision",
        "project",
        "procedure",
        "open_question",
        "relationship",
        "event",
        "skill"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "personal",
        "confidential",
        "restricted"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "kind"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "user_explicit",
            "conversation_summary",
            "document",
            "assistant_inference",
            "external_source",
            "manual_entry"
          ]
        },
        "reference": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "review_note": {
      "type": "string"
    },
    "import_policy": {
      "enum": [
        "manual_review",
        "approved_for_import",
        "do_not_import"
      ]
    }
  }
}